# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GitHub OAuth App credentials
# Get these from your GitHub Developer settings
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# Supabase Configuration (Required)
# Used for storing user sessions, profiles, and relational data (watchlist)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# MongoDB Configuration (Required for AI features)
# Used for intelligent caching of unstructured AI analysis responses
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/algomerge?retryWrites=true&w=majority-or-service-role-key"

# Secret for signing session cookies
SESSION_SECRET="a_secure_random_string_of_at_least_32_characters"
